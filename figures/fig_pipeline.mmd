%%{init: {'theme': 'base', 'themeVariables': { 'fontSize': '24px', 'fontFamily': 'arial', 'lineWidth': '3px', 'primaryColor': '#ffffff', 'primaryBorderColor': '#000000', 'lineColor': '#000000', 'clusterBkg': '#ffffff', 'clusterBorder': '#000000'}}}%%
graph TD
    %% Global Styling for Readability
    %% Use high-contrast black on white/pastel
    classDef phaseBox fill:#e1f5fe,stroke:#0277bd,stroke-width:3px,color:#000,rx:5,ry:5;
    classDef outputBox fill:#f1f8e9,stroke:#558b2f,stroke-width:3px,stroke-dasharray: 5 5,color:#000,rx:0,ry:0;
    classDef inputBox fill:#fff9c4,stroke:#fbc02d,stroke-width:3px,rx:10,ry:10,color:#000;
    classDef limitBox fill:#ffebee,stroke:#c62828,stroke-width:3px,stroke-dasharray: 5 5,color:#000,font-style:italic,rx:0,ry:0;

    %% HEAD: Inputs
    subgraph S_Inputs [INPUT SOURCES]
        direction LR
        style S_Inputs fill:#ffffff,stroke:none
        InputRes("Resume<br/>PDF/DOCX/TXT"):::inputBox
        InputJD("Job Description<br/>PDF/DOCX/TXT"):::inputBox
    end

    %% Phase 1
    subgraph Ph1 [PHASE 1: PARSING & EXTRACTION]
        direction LR
        style Ph1 fill:#f5f5f5,stroke:#9e9e9e,stroke-width:2px,stroke-dasharray: 2 2
        P1_Proc["Full Text Parsing<br/>& LLM Extraction"]:::phaseBox
        P1_Out["Validated JSON<br/>(15+ Fields)"]:::outputBox
        P1_Proc --> P1_Out
    end

    %% Phase 2
    subgraph Ph2 [PHASE 2: TAXONOMY]
        direction LR
        style Ph2 fill:#f5f5f5,stroke:#9e9e9e,stroke-width:2px,stroke-dasharray: 2 2
        P2_Proc["Keyword Taxonomy<br/>(5 Categories)"]:::phaseBox
        P2_Out["Priority Labels<br/>Req / Pref / Opt"]:::outputBox
        P2_Proc --> P2_Out
    end

    %% Phase 3
    subgraph Ph3 [PHASE 3: GAP ANALYSIS]
        direction LR
        style Ph3 fill:#f5f5f5,stroke:#9e9e9e,stroke-width:2px,stroke-dasharray: 2 2
        P3_Proc["Location-Aware<br/>Gap Analysis"]:::phaseBox
        P3_Out["Gap Report:<br/>Present vs Missing"]:::outputBox
        P3_Proc --> P3_Out
    end

    %% Phase 4
    subgraph Ph4 [PHASE 4: COMPLIANCE GATE]
        direction LR
        style Ph4 fill:#f5f5f5,stroke:#9e9e9e,stroke-width:2px,stroke-dasharray: 2 2
        P4_Proc["Deterministic<br/>Audit Checks"]:::phaseBox
        P4_Out["Audit Report<br/>(PASS / FAIL)"]:::outputBox
        P4_Proc --> P4_Out
    end

    %% Phase 5
    subgraph Ph5 [PHASE 5: DUAL SCORING]
        direction LR
        style Ph5 fill:#f5f5f5,stroke:#9e9e9e,stroke-width:2px,stroke-dasharray: 2 2
        P5_Proc["ATS Scoring +<br/>JobFit Framework"]:::phaseBox
        P5_Out["Calculated Scores<br/>(Similarity + Fuzzy)"]:::outputBox
        P5_Proc --> P5_Out
    end

    %% Phase 6
    subgraph Ph6 [PHASE 6: GUIDED REWRITE]
        direction LR
        style Ph6 fill:#f5f5f5,stroke:#9e9e9e,stroke-width:2px,stroke-dasharray: 2 2
        P6_Proc["Human-in-Loop<br/>Content Gen"]:::phaseBox
        P6_Out["Rewritten CV +<br/>Change Log"]:::outputBox
        P6_Proc --> P6_Out
    end

    %% Limitations Callout - Positioned explicitly to not clutter
    Lim[LIMITATIONS:<br/>• English-only<br/>• No OCR Support<br/>• No Synonym Match]:::limitBox

    %% Main Flow Connections
    InputRes --> Ph1
    InputJD --> Ph1
    P1_Proc --> P2_Proc
    P2_Proc --> P3_Proc
    P3_Proc --> P4_Proc
    P4_Proc --> P5_Proc
    P5_Proc --> P6_Proc

    %% Connect Limitation to Phase 1 (dashed)
    Ph1 -.- Lim
